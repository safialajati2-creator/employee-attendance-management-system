<div class="page-header">
  <div><div class="section-kicker">Personel Yönetimi</div><h1 class="page-title">Çalışanlar</h1><p class="page-subtitle">Personel listesini görüntüleyin, arayın ve çalışan profillerine tek tıklamayla ulaşın.</p></div>
  <div class="d-flex flex-wrap gap-2"><a href="/employees/import" class="btn btn-outline-success"><i class="bi bi-file-earmark-excel me-2"></i> Excel İçe Aktar</a><a href="/employees/new" class="btn btn-primary"><i class="bi bi-plus-lg me-2"></i> Yeni Çalışan</a></div>
</div>
<div class="filter-card mb-4"><form method="GET" action="/employees" class="row g-3 align-items-end"><div class="col-lg-8"><label class="form-label">Arama</label><div class="input-group"><span class="input-group-text bg-white"><i class="bi bi-search"></i></span><input type="text" name="q" class="form-control" placeholder="Ad, Soyad veya Kimlik No ile ara..." value="<%= q %>"></div></div><div class="col-lg-4 d-flex gap-2"><button class="btn btn-primary flex-fill" type="submit"><i class="bi bi-funnel me-2"></i> Ara</button><% if (q) { %><a href="/employees" class="btn btn-outline-secondary">Temizle</a><% } %></div></form></div>
<div class="card"><div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2"><div><div class="section-kicker">Liste</div><div class="fw-bold">Toplam <%= employees.length %> çalışan</div></div><div class="pagination-note">Çalışan kartlarına tıklayarak profil detayını açabilirsiniz.</div></div><div class="table-responsive"><table class="table table-modern table-hover align-middle mb-0"><thead><tr><th>Çalışan</th><th>Kimlik No</th><th>Departman</th><th>Çalışma Programı</th><th>İşe Başlama</th><th>Durum</th><th class="text-end">İşlemler</th></tr></thead><tbody>
<% if (employees.length === 0) { %><tr><td colspan="7"><div class="empty-state"><i class="bi bi-people"></i><div>Kayıt bulunamadı.</div></div></td></tr><% } %>
<% employees.forEach(function(e){ var initials=((e.firstName||'').charAt(0)+(e.lastName||'').charAt(0)).toUpperCase(); var shiftName=shiftMap&&shiftMap[e.shiftId]?shiftMap[e.shiftId].name:'Standart'; var shiftHours=shiftMap&&shiftMap[e.shiftId]?(shiftMap[e.shiftId].start+' - '+shiftMap[e.shiftId].end):'Varsayılan saat'; %>
<tr><td><div class="person-cell"><div class="person-avatar"><%= initials || 'Ç' %></div><div class="person-meta"><a href="/employees/<%= e.id %>" class="person-name text-decoration-none"><%= e.firstName %> <%= e.lastName %></a><div class="person-subtext"><%= e.notes ? e.notes : 'Çalışan profiline git' %></div></div></div></td><td><span class="fw-semibold"><%= e.kimlikNo %></span></td><td><%= e.department || '-' %></td><td><div class="fw-semibold"><%= shiftName %></div><div class="person-subtext"><%= shiftHours %></div></td><td><%= e.startDate || '-' %></td><td><% if (e.status === 'Aktif') { %><span class="badge-soft success"><i class="bi bi-check-circle-fill"></i> Aktif</span><% } else { %><span class="badge-soft dark"><i class="bi bi-pause-circle-fill"></i> Pasif</span><% } %></td><td class="text-end"><div class="d-inline-flex gap-2"><a href="/employees/<%= e.id %>" class="btn btn-sm btn-outline-primary"><i class="bi bi-eye"></i></a><a href="/employees/<%= e.id %>/edit" class="btn btn-sm btn-outline-secondary"><i class="bi bi-pencil"></i></a></div></td></tr>
<% }); %>
</tbody></table></div></div>
