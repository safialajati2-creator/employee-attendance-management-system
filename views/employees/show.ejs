<%
  var lateRecords = records.filter(function(r){ return r.late; });
  var totalLateMinutes = lateRecords.reduce(function(sum, r){ return sum + (Number(r.lateMinutes) || 0); }, 0);
  var averageLate = lateRecords.length ? Math.round((totalLateMinutes / lateRecords.length) * 10) / 10 : 0;
  var shiftName = shiftMap && shiftMap[employee.shiftId] ? shiftMap[employee.shiftId].name : 'Standart';
  var shiftHours = shiftMap && shiftMap[employee.shiftId] ? (shiftMap[employee.shiftId].start + ' - ' + shiftMap[employee.shiftId].end) : 'Varsayılan saat';
  var initials = ((employee.firstName || '').charAt(0) + (employee.lastName || '').charAt(0)).toUpperCase();
%>
<div class="page-header"><div><div class="section-kicker">Çalışan Profili</div><h1 class="page-title"><%= employee.firstName %> <%= employee.lastName %></h1><p class="page-subtitle"><%= monthName %> <%= year %> dönemine ait devam ve gecikme verileri aşağıda listelenmektedir.</p></div><div class="d-flex flex-wrap gap-2"><a href="/employees/<%= employee.id %>/edit" class="btn btn-outline-secondary"><i class="bi bi-pencil me-2"></i> Düzenle</a><a href="/employees" class="btn btn-light border"><i class="bi bi-arrow-left me-2"></i> Geri</a></div></div>
<div class="row g-4 mb-4"><div class="col-xl-4"><div class="card profile-card h-100"><div class="profile-hero"><div class="profile-avatar"><%= initials || 'Ç' %></div><div><h2 class="profile-title"><%= employee.firstName %> <%= employee.lastName %></h2><div class="d-flex flex-wrap gap-2 mt-2"><span class="badge-soft <%= employee.status === 'Aktif' ? 'success' : 'dark' %>"><%= employee.status %></span><span class="badge-soft primary"><%= employee.department || 'Departman yok' %></span></div></div></div><div class="profile-grid"><div class="detail-tile"><div class="detail-label">Kimlik No</div><div class="detail-value"><%= employee.kimlikNo %></div></div><div class="detail-tile"><div class="detail-label">İşe Başlama</div><div class="detail-value"><%= employee.startDate || '-' %></div></div><div class="detail-tile"><div class="detail-label">Çalışma Programı</div><div class="detail-value"><%= shiftName %></div></div><div class="detail-tile"><div class="detail-label">Saat Aralığı</div><div class="detail-value"><%= shiftHours %></div></div></div><% if (employee.notes) { %><div class="mt-3 pt-3 border-top"><div class="detail-label">Notlar</div><div><%= employee.notes %></div></div><% } %></div></div>
<div class="col-xl-8"><div class="row g-3"><div class="col-md-6 col-xl-3"><div class="metric-card"><div class="metric-label">Toplam Geldi</div><div class="metric-value"><%= summary.geldi %></div></div></div><div class="col-md-6 col-xl-3"><div class="metric-card"><div class="metric-label">Toplam Geç Gelme</div><div class="metric-value"><%= lateRecords.length %></div></div></div><div class="col-md-6 col-xl-3"><div class="metric-card"><div class="metric-label">Toplam Geç Kalma</div><div class="metric-value"><%= totalLateMinutes %> dk</div></div></div><div class="col-md-6 col-xl-3"><div class="metric-card"><div class="metric-label">Ortalama Geç Kalma</div><div class="metric-value"><%= averageLate %> dk</div></div></div></div></div></div>
<div class="card mb-4"><div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2"><div><div class="section-kicker">Filtre ve Dışa Aktarım</div><div class="fw-bold">Devam geçmişi</div></div><div class="d-flex gap-2 flex-wrap align-items-end"><form method="GET" action="/employees/<%= employee.id %>" class="d-flex gap-2 align-items-end flex-wrap"><select name="month" class="form-select form-select-sm"><% for (var m=1; m<=12; m++) { %><option value="<%= m %>" <%= m === month ? 'selected' : '' %>><%= m %></option><% } %></select><select name="year" class="form-select form-select-sm"><% years.forEach(function(y){ %><option value="<%= y %>" <%= y === year ? 'selected' : '' %>><%= y %></option><% }); %></select><button class="btn btn-sm btn-primary">Filtrele</button></form><a class="btn btn-sm btn-success" href="/employees/<%= employee.id %>/export/excel?year=<%= year %>&month=<%= month %>">Excel</a><a class="btn btn-sm btn-danger" href="/employees/<%= employee.id %>/export/pdf?year=<%= year %>&month=<%= month %>">PDF</a></div></div><div class="table-responsive"><table class="table table-modern table-hover align-middle mb-0"><thead><tr><th>Tarih</th><th>Gün</th><th>Durum</th><th>Giriş</th><th>Çıkış</th><th>Geç Kalma</th><th>Çalışma S.</th><th>Fazla Mesai</th><th>Açıklama</th><th></th></tr></thead><tbody><% if (records.length === 0) { %><tr><td colspan="10"><div class="empty-state">Bu ay için kayıt bulunamadı.</div></td></tr><% } %><% records.forEach(function(r){ %><tr class="<%= r.late ? 'late-row' : '' %>"><td><%= r.date %></td><td><%= dayNameTr(r.date) %></td><td><% if (r.late) { %><span class="badge status-late">⚠ GEÇ GELDİ</span><% } else { %><span class="badge status-<%= r.status === 'Geldi' ? 'geldi' : (r.status === 'Gelmedi' ? 'gelmedi' : (r.status === 'İzinli' ? 'izinli' : 'raporlu')) %>"><%= r.status %></span><% } %></td><td><%= r.checkIn || '-' %></td><td><%= r.checkOut || '-' %></td><td><%= r.late ? (r.lateMinutes + ' dk') : '-' %></td><td><%= r.workHours %></td><td><%= r.overtimeHours %></td><td><%= r.note || '-' %></td><td><a href="/attendance/<%= r.id %>/edit" class="btn btn-sm btn-outline-secondary"><i class="bi bi-pencil"></i></a></td></tr><% }); %></tbody></table></div></div>
