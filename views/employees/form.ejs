<div class="page-header">
  <div><div class="section-kicker">Personel Kartı</div><h1 class="page-title"><%= title %></h1><p class="page-subtitle">Çalışan bilgilerini ve çalışma programını eksiksiz olarak tanımlayın.</p></div>
  <a href="/employees" class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-2"></i> Geri</a>
</div>
<% if (errors && errors.length) { %><div class="alert alert-danger app-alert"><strong>Lütfen aşağıdaki hataları düzeltin:</strong><ul class="mb-0 mt-2"><% errors.forEach(function(err){ %><li><%= err %></li><% }); %></ul></div><% } %>
<div class="card"><div class="card-body"><form method="POST" action="<%= formAction %>"><div class="row g-3"><div class="col-md-6"><label class="form-label">Ad <span class="text-danger">*</span></label><input type="text" name="firstName" class="form-control" value="<%= employee.firstName %>" required></div><div class="col-md-6"><label class="form-label">Soyad <span class="text-danger">*</span></label><input type="text" name="lastName" class="form-control" value="<%= employee.lastName %>" required></div><div class="col-md-6"><label class="form-label">Kimlik No <span class="text-danger">*</span></label><input type="text" name="kimlikNo" class="form-control" value="<%= employee.kimlikNo %>" pattern="\d{11}" maxlength="11" title="11 haneli rakam" required><div class="form-text">11 haneli ve benzersiz olmalıdır.</div></div><div class="col-md-6"><label class="form-label">Departman</label><input type="text" name="department" class="form-control" value="<%= employee.department %>"></div><div class="col-md-6"><label class="form-label">Kayıt Yapacak Süpervizör</label><select name="attendanceSupervisor" class="form-select"><option value="">Tümü</option><% (supervisors || []).forEach(function(s){ %><option value="<%=s.username%>" <%=employee.attendanceSupervisor===s.username?'selected':''%>><%=s.name%></option><% }) %></select><label class="form-label mt-3">Çalışma Programı</label><select name="shiftId" class="form-select"><option value="">Standart</option><% (shifts || []).forEach(function(s){ %><option value="<%= s.id %>" <%= employee.shiftId===s.id ? 'selected':'' %>><%= s.name %> (<%= s.start %>-<%= s.end %>)</option><% }) %></select></div><div class="col-md-6"><label class="form-label">İşe Başlama Tarihi</label><input type="date" name="startDate" class="form-control" value="<%= employee.startDate %>"></div><div class="col-md-6"><label class="form-label">Durum</label><select name="status" class="form-select"><option value="Aktif" <%= employee.status === 'Aktif' ? 'selected' : '' %>>Aktif</option><option value="Pasif" <%= employee.status === 'Pasif' ? 'selected' : '' %>>Pasif</option></select></div><div class="col-12"><label class="form-label">Notlar</label><textarea name="notes" class="form-control" rows="4"><%= employee.notes %></textarea></div></div><div class="mt-4 d-flex gap-2"><button type="submit" class="btn btn-primary"><i class="bi bi-save me-2"></i> Kaydet</button><a href="/employees" class="btn btn-light border">İptal</a></div></form></div></div>
