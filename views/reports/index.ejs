<div class="d-flex justify-content-between align-items-center mb-4"><h3 class="mb-0"><i class="bi bi-bar-chart"></i> Raporlar</h3></div>
<div class="card shadow-sm mb-4"><div class="card-body"><form method="GET" action="/reports" class="row g-3 align-items-end"><div class="col-6 col-md-3"><label class="form-label">Ay</label><select name="month" class="form-select"><% for (var m=1; m<=12; m++) { %><option value="<%= m %>" <%= m === month ? 'selected' : '' %>><%= m %></option><% } %></select></div><div class="col-6 col-md-3"><label class="form-label">Yıl</label><select name="year" class="form-select"><% years.forEach(function(y){ %><option value="<%= y %>" <%= y === year ? 'selected' : '' %>><%= y %></option><% }); %></select></div><div class="col-md-3"><div class="form-check mt-4"><input class="form-check-input" type="checkbox" name="includePassive" value="1" id="passiveChk" <%= includePassive ? 'checked' : '' %>><label class="form-check-label" for="passiveChk">Pasif çalışanları da göster</label></div></div><div class="col-md-3 d-flex gap-2"><button class="btn btn-primary"><i class="bi bi-funnel"></i> Göster</button><a class="btn btn-success" href="/reports/export/excel?year=<%= year %>&month=<%= month %>&includePassive=<%= includePassive ? '1' : '0' %>"><i class="bi bi-file-earmark-excel"></i> Excel indir</a></div></form></div></div>
<div class="card shadow-sm"><div class="card-header bg-white fw-bold">Aylık Özet — <%= monthName %> <%= year %></div><div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th>Ad Soyad</th><th>Kimlik No</th><th>Departman</th><th>Geldi</th><th>Gelmedi</th><th>İzinli</th><th>Raporlu</th><th>Toplam Çalışma S.</th><th>Toplam Fazla Mesai S.</th></tr></thead><tbody><% if (rows.length === 0) { %><tr><td colspan="9" class="text-center text-muted py-4">Çalışan bulunamadı.</td></tr><% } %><% rows.forEach(function(row){ %><tr><td><a href="/employees/<%= row.employee.id %>?year=<%= year %>&month=<%= month %>" class="text-decoration-none fw-semibold"><%= row.employee.firstName %> <%= row.employee.lastName %></a><% if (row.employee.status === 'Pasif') { %><span class="badge bg-secondary ms-1">Pasif</span><% } %></td><td><%= row.employee.kimlikNo %></td><td><%= row.employee.department || '-' %></td><td><span class="badge status-geldi"><%= row.summary.geldi %></span></td><td><span class="badge status-gelmedi"><%= row.summary.gelmedi %></span></td><td><span class="badge status-izinli"><%= row.summary.izinli %></span></td><td><span class="badge status-raporlu"><%= row.summary.raporlu %></span></td><td><%= row.summary.totalWorkHours %></td><td><%= row.summary.totalOvertimeHours %></td></tr><% }); %></tbody></table></div></div>
