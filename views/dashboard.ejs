<div class="page-header">
  <div><div class="section-kicker">Yönetim Özeti</div><h1 class="page-title">Hoş geldiniz</h1><p class="page-subtitle">Bugünün devam verilerini, gecikmeleri ve hızlı erişim bağlantılarını bu ekrandan takip edebilirsiniz.</p></div>
  <div class="d-flex flex-wrap gap-2"><span class="info-chip"><i class="bi bi-calendar-event"></i> <%= todayStr %></span><span class="info-chip"><i class="bi bi-sun"></i> <%= todayDayName %></span></div>
</div>
<div class="card hero-card mb-4"><div class="card-body"><div class="hero-grid"><div><div class="section-kicker text-white-50">Günlük Durum</div><h2 class="mb-2 fw-bold">Şirket içi devam takibini tek ekrandan yönetin</h2><p class="page-subtitle mb-4">Bugün sisteme girilen kayıtları, geç gelen personelleri ve hızlı aksiyon alanlarını özetledik.</p><div class="d-flex flex-wrap gap-2 hero-meta"><span class="badge-soft dark">Aktif personel: <%= activeCount %></span><span class="badge-soft dark">Pasif personel: <%= passiveCount %></span><span class="badge-soft dark">Bugünkü kayıt: <%= todaySummary.total %></span></div></div><div class="hero-stat-list"><div class="hero-mini-card"><div class="label-muted text-white-50">Bugün Gelen</div><div class="metric-value text-white"><%= todaySummary.geldi %></div></div><div class="hero-mini-card"><div class="label-muted text-white-50">Geç Gelen</div><div class="metric-value text-white"><%= lateToday %></div><div class="hero-meta">Toplam gecikme: <%= lateMinutesToday %> dk</div></div><div class="hero-mini-card"><div class="label-muted text-white-50">Kayıt Bekleyen</div><div class="metric-value text-white"><%= waitingCount %></div></div><div class="hero-mini-card"><div class="label-muted text-white-50">En Çok Geciken</div><div class="metric-value text-white" style="font-size:1.2rem;"><%= topLateEmployee ? topLateEmployee.name : '—' %></div><div class="hero-meta"><%= topLateEmployee ? (topLateEmployee.minutes + ' dk') : 'Bugün gecikme kaydı yok' %></div></div></div></div></div></div>
<div class="row g-3 mb-4">
  <div class="col-md-6 col-xl-3"><div class="metric-card"><div class="metric-icon success"><i class="bi bi-people-fill"></i></div><div class="metric-label">Aktif Çalışan</div><div class="metric-value"><%= activeCount %></div></div></div>
  <div class="col-md-6 col-xl-3"><div class="metric-card"><div class="metric-icon primary"><i class="bi bi-clipboard-check-fill"></i></div><div class="metric-label">Bugünkü Kayıt</div><div class="metric-value"><%= todaySummary.total %></div></div></div>
  <div class="col-md-6 col-xl-3"><div class="metric-card"><div class="metric-icon warning"><i class="bi bi-alarm-fill"></i></div><div class="metric-label">Toplam Geç Gelen</div><div class="metric-value"><%= lateToday %></div></div></div>
  <div class="col-md-6 col-xl-3"><div class="metric-card"><div class="metric-icon dark"><i class="bi bi-hourglass-split"></i></div><div class="metric-label">Toplam Geç Kalma Süresi</div><div class="metric-value"><%= lateMinutesToday %> dk</div></div></div>
</div>
<div class="row g-4 mb-4"><div class="col-xl-7"><div class="soft-panel h-100"><div class="soft-panel-header"><div><div class="section-kicker">Bugünkü Devam Özeti</div><h5 class="mb-0">Durum dağılımı</h5></div></div><div class="row g-3"><div class="col-sm-6 col-lg-3"><div class="metric-card h-100"><div class="metric-label">Geldi</div><div class="metric-value"><%= todaySummary.geldi %></div></div></div><div class="col-sm-6 col-lg-3"><div class="metric-card h-100"><div class="metric-label">Gelmedi</div><div class="metric-value"><%= todaySummary.gelmedi %></div></div></div><div class="col-sm-6 col-lg-3"><div class="metric-card h-100"><div class="metric-label">İzinli</div><div class="metric-value"><%= todaySummary.izinli %></div></div></div><div class="col-sm-6 col-lg-3"><div class="metric-card h-100"><div class="metric-label">Raporlu</div><div class="metric-value"><%= todaySummary.raporlu %></div></div></div></div></div></div><div class="col-xl-5"><div class="soft-panel h-100"><div class="soft-panel-header"><div><div class="section-kicker">Son Hareketler</div><h5 class="mb-0">Bugünkü son girişler</h5></div></div><% if (recentEntries && recentEntries.length) { %><ul class="list-clean"><% recentEntries.forEach(function(item){ %><li class="d-flex justify-content-between align-items-center gap-3"><div class="person-cell"><div class="person-avatar"><%= item.initials %></div><div class="person-meta"><div class="person-name"><%= item.name %></div><div class="person-subtext"><%= item.department || 'Departman belirtilmedi' %></div></div></div><div class="text-end"><div class="fw-semibold"><%= item.checkIn || '-' %></div><span class="badge-soft <%= item.late ? 'warning' : 'success' %>"><%= item.late ? ('GEÇ GELDİ · ' + item.lateMinutes + ' dk') : item.status %></span></div></li><% }) %></ul><% } else { %><div class="empty-state"><i class="bi bi-clock-history"></i><div>Bugün için henüz giriş kaydı bulunmuyor.</div></div><% } %></div></div></div>
<div class="row g-3"><div class="col-md-6 col-xl-3"><a href="/employees" class="quick-link-card"><span>Çalışanlar</span><i class="bi bi-arrow-right"></i></a></div><div class="col-md-6 col-xl-3"><a href="/attendance" class="quick-link-card"><span>Günlük Kayıt</span><i class="bi bi-arrow-right"></i></a></div><div class="col-md-6 col-xl-3"><a href="/late" class="quick-link-card"><span>Geç Gelenler</span><i class="bi bi-arrow-right"></i></a></div><div class="col-md-6 col-xl-3"><a href="/reports" class="quick-link-card"><span>Raporlar</span><i class="bi bi-arrow-right"></i></a></div></div>
