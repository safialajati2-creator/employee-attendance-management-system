<div class="page-header"><div><div class="section-kicker">Tatil Yönetimi</div><h1 class="page-title">Günlük Tatiller</h1><p class="page-subtitle">Resmî tatil ve şirket içi tatil günlerini kaydedin.</p></div></div>
<div class="row g-4"><div class="col-xl-5"><div class="card"><div class="card-header"><div class="fw-bold">Yeni Tatil Ekle</div></div><div class="card-body"><form method="post"><div class="mb-3"><label class="form-label">Tarih</label><input class="form-control" type="date" name="date" required></div><div class="mb-3"><label class="form-label">Açıklama</label><input class="form-control" name="name" placeholder="Bayram / Tatil adı" required></div><button class="btn btn-primary">Tatil Ekle</button></form></div></div></div><div class="col-xl-7"><div class="card"><div class="card-header"><div class="fw-bold">Kayıtlı Tatiller</div></div><div class="table-responsive"><table class="table table-modern mb-0"><thead><tr><th>Tarih</th><th>Açıklama</th></tr></thead><tbody><% if (!holidays.length) { %><tr><td colspan="2" class="text-center text-muted py-4">Kayıtlı tatil bulunmuyor.</td></tr><% } %><% holidays.forEach(h=>{%><tr><td><%=h.date%></td><td><%=h.name%></td></tr><%})%></tbody></table></div></div></div></div>
