<!DOCTYPE html>
<html lang="tr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Devam Takip Sistemi</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
  <link href="/public/css/style.css" rel="stylesheet">
</head>
<body class="admin-app">
  <div class="app-shell">
    <aside class="offcanvas-lg offcanvas-start app-sidebar" tabindex="-1" id="sidebarNav">
      <div class="offcanvas-header border-bottom"><div><div class="sidebar-brand"><i class="bi bi-calendar-check"></i> Devam Takip</div><div class="sidebar-subtitle">HR Attendance System</div></div><button type="button" class="btn-close d-lg-none" data-bs-dismiss="offcanvas" data-bs-target="#sidebarNav"></button></div>
      <div class="offcanvas-body d-flex flex-column p-0">
        <div class="sidebar-user-card mx-3 mt-3 mb-2"><div class="sidebar-user-icon"><i class="bi bi-person-circle"></i></div><div><div class="sidebar-user-label">Oturum</div><div class="sidebar-user-name"><%= currentUser || 'Yönetici' %></div></div></div>
        <nav class="sidebar-nav px-2 pb-3">
          <div class="sidebar-nav-title">MENÜ</div>
          <a class="sidebar-link <%= currentPath === '/' ? 'active' : '' %>" href="/"><i class="bi bi-grid-1x2-fill"></i><span>Panel</span></a>
          <% if (userRole === 'supervisor') { %>
            <a class="sidebar-link <%= currentPath.startsWith('/attendance') ? 'active' : '' %>" href="/attendance"><i class="bi bi-clipboard-data-fill"></i><span>Kayıt Gir</span></a>
          <% } else { %>
            <a class="sidebar-link <%= currentPath.startsWith('/employees') && !currentPath.startsWith('/employees/import') ? 'active' : '' %>" href="/employees"><i class="bi bi-people-fill"></i><span>Çalışanlar</span></a>
            <a class="sidebar-link <%= currentPath.startsWith('/attendance') ? 'active' : '' %>" href="/attendance"><i class="bi bi-clipboard-data-fill"></i><span>Günlük Kayıt</span></a>
            <a class="sidebar-link <%= currentPath.startsWith('/late') ? 'active' : '' %>" href="/late"><i class="bi bi-alarm-fill"></i><span>Geç Gelenler</span></a>
            <a class="sidebar-link <%= currentPath.startsWith('/reports') ? 'active' : '' %>" href="/reports"><i class="bi bi-bar-chart-line-fill"></i><span>Raporlar</span></a>
            <div class="sidebar-nav-title mt-3">YÖNETİM</div>
            <a class="sidebar-link <%= currentPath.startsWith('/employees/import') ? 'active' : '' %>" href="/employees/import"><i class="bi bi-file-earmark-excel-fill"></i><span>Excel İçe Aktar</span></a>
            <a class="sidebar-link <%= currentPath.startsWith('/shifts') ? 'active' : '' %>" href="/shifts"><i class="bi bi-clock-history"></i><span>Vardiyalar</span></a>
            <a class="sidebar-link <%= currentPath.startsWith('/settings') ? 'active' : '' %>" href="/settings"><i class="bi bi-sliders"></i><span>Ayarlar</span></a>
            <a class="sidebar-link <%= currentPath.startsWith('/backups') ? 'active' : '' %>" href="/backups"><i class="bi bi-database-fill-lock"></i><span>Yedekler</span></a>
          <% } %>
        </nav>
        <% if (isAuthenticated) { %><div class="sidebar-footer mt-auto px-3 py-3 border-top"><form action="/logout" method="POST"><button type="submit" class="btn btn-outline-light w-100 rounded-3"><i class="bi bi-box-arrow-right me-2"></i> Çıkış Yap</button></form></div><% } %>
      </div>
    </aside>
    <div class="app-main">
      <header class="app-topbar"><div class="d-flex align-items-center gap-2"><button class="btn btn-light d-lg-none topbar-menu-btn" type="button" data-bs-toggle="offcanvas" data-bs-target="#sidebarNav"><i class="bi bi-list"></i></button><div><div class="topbar-eyebrow">Kurumsal Devam Takip Sistemi</div><div class="topbar-title"><%= title %></div></div></div><div class="topbar-actions"><div class="topbar-date-chip"><i class="bi bi-calendar3"></i><span><%= new Date().toLocaleDateString('tr-TR') %></span></div></div></header>
      <main class="app-content">
        <% if (flash) { %><div class="alert alert-<%= flash.type %> alert-dismissible fade show app-alert" role="alert"><i class="bi <%= flash.type === 'success' ? 'bi-check-circle-fill' : (flash.type === 'warning' ? 'bi-exclamation-triangle-fill' : 'bi-info-circle-fill') %> me-2"></i><%= flash.message %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div><% } %>
        <%- body %>
      </main>
    </div>
  </div>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="/public/js/main.js"></script>
</body>
</html>
