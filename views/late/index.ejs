<div class="page-header"><div><div class="section-kicker">Gecikme Yönetimi</div><h1 class="page-title">Geç Gelenler</h1><p class="page-subtitle">Geç gelen personelleri, gecikme sürelerini ve rapor çıktılarını tek ekranda görüntüleyin.</p></div><div class="d-flex gap-2 flex-wrap"><a class="btn btn-success" href="/late/excel"><i class="bi bi-file-earmark-excel me-2"></i> Excel İndir</a><a class="btn btn-danger" href="/late/pdf"><i class="bi bi-file-earmark-pdf me-2"></i> PDF İndir</a></div></div>
<div class="row g-3 mb-4"><div class="col-md-4"><div class="metric-card"><div class="metric-label">Geç Gelme Kaydı</div><div class="metric-value"><%= summary.totalCount %></div></div></div><div class="col-md-4"><div class="metric-card"><div class="metric-label">Toplam Gecikme</div><div class="metric-value"><%= summary.totalMinutes %> dk</div></div></div><div class="col-md-4"><div class="metric-card"><div class="metric-label">En Çok Geciken</div><div class="metric-value" style="font-size:1.15rem;"><%= summary.topEmployee ? summary.topEmployee.name : '—' %></div><div class="metric-note"><%= summary.topEmployee ? (summary.topEmployee.minutes + ' dk') : 'Kayıt yok' %></div></div></div></div>
<div class="filter-card mb-4"><form method="GET" action="/late" class="row g-3 align-items-end"><div class="col-md-5"><label class="form-label">Personel / Departman / Kimlik No</label><input type="text" name="q" class="form-control" value="<%= filters.q %>" placeholder="Arama..."></div><div class="col-md-3"><label class="form-label">Yıl</label><select name="year" class="form-select"><option value="">Tümü</option><% years.forEach(function(y){ %><option value="<%= y %>" <%= filters.year === y ? 'selected' : '' %>><%= y %></option><% }); %></select></div><div class="col-md-2"><label class="form-label">Ay</label><select name="month" class="form-select"><option value="">Tümü</option><% for (var m=1;m<=12;m++) { %><option value="<%= m %>" <%= String(parseInt(filters.month || '0',10)) === String(m) ? 'selected' : '' %>><%= m %></option><% } %></select></div><div class="col-md-2"><button class="btn btn-primary w-100">Filtrele</button></div></form></div>
<div class="card"><div class="table-responsive"><table class="table table-modern align-middle mb-0"><thead><tr><th>Personel</th><th>Departman</th><th>Tarih</th><th>Giriş</th><th>Planlanan</th><th>Gecikme</th><th>Durum</th></tr></thead><tbody><% if (!rows.length) { %><tr><td colspan="7"><div class="empty-state">Filtreye uygun geç gelme kaydı bulunamadı.</div></td></tr><% } %><% rows.forEach(function(r){ var initials=((r.e.firstName||'').charAt(0)+(r.e.lastName||'').charAt(0)).toUpperCase(); %><tr><td><div class="person-cell"><div class="person-avatar"><%= initials || 'Ç' %></div><div class="person-meta"><div class="person-name"><%= r.e.firstName %> <%= r.e.lastName %></div><div class="person-subtext">Kimlik No: <%= r.e.kimlikNo %></div></div></div></td><td><%= r.e.department || '-' %></td><td><%= r.a.date %></td><td><%= r.a.checkIn || '-' %></td><td><%= r.scheduledStart || '-' %></td><td><span class="badge-soft warning"><%= r.a.lateMinutes %> dk</span></td><td><span class="badge status-late">⚠ GEÇ GELDİ</span></td></tr><% }) %></tbody></table></div></div>
