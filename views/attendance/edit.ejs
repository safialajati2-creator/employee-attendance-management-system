<div class="d-flex justify-content-between align-items-center mb-4">
  <h3 class="mb-0"><i class="bi bi-pencil-square"></i> Devam Kaydı Düzenle</h3>
  <a href="/employees/<%= record.employeeId %>" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Geri</a>
</div>
<% if (errors && errors.length) { %><div class="alert alert-danger"><strong>Lütfen hataları düzeltin:</strong><ul class="mb-0 mt-1"><% errors.forEach(function(err){ %><li><%= err %></li><% }); %></ul></div><% } %>
<div class="card shadow-sm"><div class="card-header bg-white"><strong><%= employee ? (employee.firstName + ' ' + employee.lastName) : 'Çalışan' %></strong> &middot; Tarih: <strong><%= record.date %></strong></div><div class="card-body"><form method="POST" action="/attendance/<%= record.id %>"><div class="row g-3"><div class="col-md-4"><label class="form-label">Durum</label><select name="status" class="form-select status-select"><% statuses.forEach(function(s){ %><option value="<%= s %>" <%= record.status === s ? 'selected' : '' %>><%= s %></option><% }); %></select></div><div class="col-md-4"><label class="form-label">Giriş Saati</label><input type="time" name="checkIn" class="form-control" value="<%= record.checkIn || '' %>"></div><div class="col-md-4"><label class="form-label">Çıkış Saati</label><input type="time" name="checkOut" class="form-control" value="<%= record.checkOut || '' %>"></div><div class="col-md-4"><label class="form-label">Fazla Mesai Başlangıç</label><input type="time" name="overtimeStart" class="form-control" value="<%= record.overtimeStart || '' %>"></div><div class="col-md-4"><label class="form-label">Fazla Mesai Bitiş</label><input type="time" name="overtimeEnd" class="form-control" value="<%= record.overtimeEnd || '' %>"></div><div class="col-md-4"><label class="form-label">Sağlık Raporu Var mı?</label><select name="medicalReport" class="form-select"><option value="Hayır" <%= record.medicalReport === 'Hayır' ? 'selected' : '' %>>Hayır</option><option value="Evet" <%= record.medicalReport === 'Evet' ? 'selected' : '' %>>Evet</option></select></div><div class="col-md-6"><label class="form-label">Devamsızlık Sebebi</label><input type="text" name="absenceReason" class="form-control" value="<%= record.absenceReason || '' %>"></div><div class="col-md-6"><label class="form-label">Açıklama</label><input type="text" name="note" class="form-control" value="<%= record.note || '' %>"></div></div><div class="mt-4"><button type="submit" class="btn btn-primary"><i class="bi bi-save"></i> Kaydet</button><a href="/employees/<%= record.employeeId %>" class="btn btn-light">İptal</a></div><p class="text-muted small mt-2">Kaydettiğinizde çalışma saati ve fazla mesai saati otomatik yeniden hesaplanır.</p></form></div></div>
