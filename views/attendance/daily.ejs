<%
  var existingCount = 0;
  employees.forEach(function(e){ if ((submitted && submitted[e.id] && submitted[e.id].status) || byEmp[e.id]) existingCount++; });
%>
<div class="page-header">
  <div><div class="section-kicker">Günlük Operasyon</div><h1 class="page-title">Günlük Kayıt</h1><p class="page-subtitle">Seçili tarihteki tüm çalışanların durumlarını, giriş/çıkış saatlerini ve notlarını bu ekrandan kaydedin.</p></div>
  <form method="GET" action="/attendance" class="d-flex gap-2 align-items-end flex-wrap"><div><label class="form-label small mb-1">Tarih</label><input type="date" name="date" class="form-control form-control-sm" value="<%= date %>"></div><button class="btn btn-primary"><i class="bi bi-calendar-event me-2"></i> Getir</button></form>
</div>
<div class="row g-3 mb-4"><div class="col-md-4"><div class="metric-card"><div class="metric-label">Seçili Tarih</div><div class="metric-value" style="font-size:1.25rem;"><%= date %></div><div class="metric-note"><%= dayName %></div></div></div><div class="col-md-4"><div class="metric-card"><div class="metric-label">Aktif Çalışan</div><div class="metric-value"><%= employees.length %></div></div></div><div class="col-md-4"><div class="metric-card"><div class="metric-label">Mevcut Kayıt</div><div class="metric-value"><%= existingCount %></div></div></div></div>
<div class="alert alert-info app-alert"><i class="bi bi-info-circle me-2"></i> Durum seçilmeyen çalışanlar kaydedilmez. Aynı tarihe ait mevcut kayıt varsa sistem otomatik olarak günceller.</div>
<% if (errors && errors.length) { %><div class="alert alert-danger app-alert"><strong>Kaydedilemedi, lütfen hataları düzeltin:</strong><ul class="mb-0 mt-2"><% errors.forEach(function(err){ %><li><%= err %></li><% }); %></ul></div><% } %>
<form method="POST" action="/attendance/save"><input type="hidden" name="date" value="<%= date %>"><div class="card"><div class="card-header"><div class="section-kicker">Devam Formu</div><div class="fw-bold">Personel yoklama listesi</div></div><div class="table-responsive"><table class="table table-modern align-middle mb-0"><thead><tr><th style="min-width:220px;">Çalışan</th><th style="min-width:150px;">Durum</th><th>Giriş</th><th>Çıkış</th><th>F.M. Başlangıç</th><th>F.M. Bitiş</th><th style="min-width:160px;">Devamsızlık Sebebi</th><th>Sağlık Raporu</th><th style="min-width:180px;">Açıklama</th></tr></thead><tbody>
<% if (employees.length === 0) { %><tr><td colspan="9"><div class="empty-state"><i class="bi bi-people"></i><div>Aktif çalışan bulunamadı. Önce çalışan ekleyin.</div></div></td></tr><% } %>
<% employees.forEach(function(e){ var cur=(submitted&&submitted[e.id])?submitted[e.id]:(byEmp[e.id]||{}); var initials=((e.firstName||'').charAt(0)+(e.lastName||'').charAt(0)).toUpperCase(); %>
<tr class="attendance-row <%= cur.late ? 'late-row' : '' %>"><td><div class="person-cell"><div class="person-avatar"><%= initials || 'Ç' %></div><div class="person-meta"><div class="person-name"><%= e.firstName %> <%= e.lastName %></div><div class="person-subtext"><%= e.department || 'Departman belirtilmedi' %></div><% if (cur.late) { %><span class="badge-soft warning mt-1">⚠️ GEÇ GELDİ · <%= cur.lateMinutes %> dk</span><% } %></div></div></td><td><select name="rows[<%= e.id %>][status]" class="form-select form-select-sm status-select"><option value="">— Seçiniz —</option><% statuses.forEach(function(s){ %><option value="<%= s %>" <%= cur.status === s ? 'selected' : '' %>><%= s %></option><% }); %></select></td><td><input type="time" name="rows[<%= e.id %>][checkIn]" class="form-control form-control-sm" value="<%= cur.checkIn || '' %>"></td><td><input type="time" name="rows[<%= e.id %>][checkOut]" class="form-control form-control-sm" value="<%= cur.checkOut || '' %>"></td><td><input type="time" name="rows[<%= e.id %>][overtimeStart]" class="form-control form-control-sm" value="<%= cur.overtimeStart || '' %>"></td><td><input type="time" name="rows[<%= e.id %>][overtimeEnd]" class="form-control form-control-sm" value="<%= cur.overtimeEnd || '' %>"></td><td><input type="text" name="rows[<%= e.id %>][absenceReason]" class="form-control form-control-sm" value="<%= cur.absenceReason || '' %>"></td><td><select name="rows[<%= e.id %>][medicalReport]" class="form-select form-select-sm"><option value="Hayır" <%= cur.medicalReport === 'Hayır' || !cur.medicalReport ? 'selected' : '' %>>Hayır</option><option value="Evet" <%= cur.medicalReport === 'Evet' ? 'selected' : '' %>>Evet</option></select></td><td><input type="text" name="rows[<%= e.id %>][note]" class="form-control form-control-sm" value="<%= cur.note || '' %>"></td></tr>
<% }); %>
</tbody></table></div><div class="card-footer bg-white text-end"><button type="submit" class="btn btn-primary"><i class="bi bi-save me-2"></i> Kayıtları Kaydet</button></div></div></form>
