# Administrator credentials (local environment only)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD

# Optional supervisor account
SUPERVISOR_USERNAME=supervisor
SUPERVISOR_PASSWORD=CHANGE_ME_SUPERVISOR_PASSWORD

# Use a long random value in real deployments
SESSION_SECRET=CHANGE_ME_WITH_A_LONG_RANDOM_SECRET

# Optional absolute path to a Unicode TTF font for Turkish PDF output
# PDF_FONT_PATH=/absolute/path/to/DejaVuSans.ttf
# PDF_FONT_BOLD_PATH=/absolute/path/to/DejaVuSans-Bold.ttf

PORT=3000
